[Unit]
Description=Game of Life wallpaper and screensaver after two idle minutes
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
ExecStart=%h/.local/bin/game_of_life --wallpaper --alternate --idle 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
