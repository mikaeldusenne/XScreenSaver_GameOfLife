set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "No installation manifest. Install this build first.")
endif()
file(STRINGS "${manifest}" files)
foreach(path IN LISTS files)
  set(target "$ENV{DESTDIR}${path}")
  if(IS_DIRECTORY "${target}" AND NOT IS_SYMLINK "${target}")
    message(FATAL_ERROR "Refusing to remove a directory: ${target}")
  endif()
  if(EXISTS "${target}" OR IS_SYMLINK "${target}")
    message(STATUS "Removing ${target}")
    file(REMOVE "${target}")
    if(EXISTS "${target}" OR IS_SYMLINK "${target}")
      message(FATAL_ERROR "Could not remove ${target}; check permissions")
    endif()
  endif()
endforeach()
